# Rodando a API direto (uvicorn): localhost
# Rodando a API pelo docker compose do backend: troque localhost por host.docker.internal
# Em produção: aponte para o endpoint do RDS
DATABASE_URL=postgresql+psycopg://sbg_user:sbg_password@localhost:5432/sbg

# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://app.jvictor.cloud,http://localhost:5173

# Porta exposta pelo docker compose do backend (EC2: 80)
API_PORT=80

# Rate limit por IP no POST /checkins ("30/minute", "5/second", "100/hour")
CHECKIN_RATE_LIMIT=30/minute
